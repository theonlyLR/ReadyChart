# Copy to .env.local (git-ignored) for the dev/preview server. In production set the same names in Vercel Project Settings.
# The first key found wins: Gemini, then Anthropic, then OpenAI.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
# GEMINI_MODEL=
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# Production only: extra origins/hosts allowed to call /api/* (same-host is always allowed), comma-separated
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
